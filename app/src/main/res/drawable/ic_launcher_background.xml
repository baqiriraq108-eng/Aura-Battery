<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- ================= 1. جسم الحاوية البرتقالية الطينية الكامل (بدون أي إطار خارجي) ================= -->
    <!-- السطح الأساسي للأيقونة بلون مطفأ يملأ كامل المساحة 512x512 -->
    <path android:pathData="M0,0 H512 V512 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="409.6"
                android:endY="460.8"
                android:startX="102.4"
                android:startY="51.2"
                android:type="linear">
                <item
                    android:color="#FFC5684D"
                    android:offset="0.0" />
                <item
                    android:color="#FFBC6047"
                    android:offset="0.5" />
                <item
                    android:color="#FFB2573E"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- شطفة إضاءة علوية جافة وغير عاكسة مطابقة للتصميم الأصلي -->
    <path android:pathData="M0,0 H512 V256 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="256.0"
                android:endY="256.0"
                android:startX="256.0"
                android:startY="0.0"
                android:type="linear">
                <item
                    android:color="#33DDA18F"
                    android:offset="0.0" />
                <item
                    android:color="#00BC6047"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
