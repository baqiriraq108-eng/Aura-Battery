<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/olive_background_dark</item>
        <item name="android:colorBackground">@color/olive_background_dark</item>
        <item name="android:statusBarColor">#1B3328</item>
        <item name="android:navigationBarColor">@color/olive_background_dark</item>
        <!-- Disable Android 12+ Splash Screen icon flash & white glow on cold start in dark mode -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/olive_background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@color/transparent_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/transparent_splash</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
